<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <RootNamespace>Cantoria</RootNamespace>
    <PackageId>Cantoria.Core</PackageId>
    <Version>0.4.0</Version>
    <Authors>Yoshifumi Tsuda</Authors>
    <Description>A singing engine for notation software: notes with lyrics in, a voice out.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/yotsuda/cantoria</RepositoryUrl>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <!-- DirectML.dll is copied by Microsoft.AI.DirectML's props only for a named PlatformTarget (the
       default AnyCPU copies nothing, and the first pack shipped without it — the inbox Windows
       DirectML stood in on the build machine); x64 is the one Windows target published. The debug
       layer is not shipped. -->
  <PropertyGroup Condition="'$(UseDirectML)' == 'true'">
    <PlatformTarget>x64</PlatformTarget>
    <Microsoft_AI_DirectML_SkipDebugLayerCopy>true</Microsoft_AI_DirectML_SkipDebugLayerCopy>
  </PropertyGroup>

  <ItemGroup>
    <!-- The diffsinger backend: ONNX inference (MIT) and the voices' YAML (MIT); see THIRD-PARTY-NOTICES.md.
         The two ONNX Runtime packages carry the same managed API over different native libraries,
         and cannot be referenced together: the DirectML one (Windows; its library runs the CPU
         provider too, and brings Microsoft's redistributable DirectML.dll) is taken when
         UseDirectML=true — the Windows program's publish (tools/pack-extension.ps1); the CPU one
         otherwise (every platform, the tests). Switching needs a restore: `dotnet build -p:UseDirectML=true`. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.23.0" Condition="'$(UseDirectML)' == 'true'" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.23.0" Condition="'$(UseDirectML)' != 'true'" />
    <PackageReference Include="YamlDotNet" Version="15.1.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\NOTICE" Pack="true" PackagePath="\" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
